# PostgreSQL credentials and host-side port mapping
POSTGRES_DB=bminfo
POSTGRES_USER=bminfo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_SHM_SIZE=256MB

# PostgreSQL tuning for approximately 3-6 months of retained data.
# Adjust shared_buffers and effective_cache_size to match available host RAM.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=150
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_AUTOVACUUM_MAX_WORKERS=5
POSTGRES_AUTOVACUUM_NAPTIME=15s
POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.02
POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.01
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_COMPRESSION=on

# Django application and its separate PostgreSQL database.
# Keep these settings together when deploying the Django implementation.
DJANGO_POSTGRES_DB=bminfo_django
DJANGO_POSTGRES_USER=bminfo_django
DJANGO_POSTGRES_PASSWORD=change-this-django-database-password
DJANGO_POSTGRES_HOST=django-postgres
DJANGO_POSTGRES_PORT=5432
DJANGO_POSTGRES_SHM_SIZE=256MB
DJANGO_POSTGRES_MAX_CONNECTIONS=100
DJANGO_SECRET_KEY=change-this-django-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://bminfo.ea7klk.es
# Keep Django connections short-lived, including connections created by the
# background collector threads. Increase only after checking database usage.
DJANGO_DB_CONN_MAX_AGE=0
DJANGO_MIGRATION_BATCH_SIZE=1000
DJANGO_WORKERS=2
DJANGO_HOST_PORT=8001
DJANGO_COLLECTOR_ENABLED=true
DJANGO_ADMIN_CALLSIGN=ADMIN

BM_URL=https://api.brandmeister.network
BM_SOCKETIO_PATH=/lh/socket.io
BM_JOIN=everything
TALKGROUPS_URL=https://api.brandmeister.network/v2/talkgroup
TALKGROUPS_SYNC_HOURS=24
EXCLUDE_LOCAL_TALKGROUP=9
KERCHUNK_THRESHOLD_SECONDS=3
# Minimum completed-session duration to retain in raw_events. This may be
# lower than the QSO threshold to preserve short transmissions for analysis.
RAW_EVENT_KERCHUNK_THRESHOLD_SECONDS=3
COLLECTOR_HEARTBEAT_SECONDS=30
# Maximum time used to finish an in-flight event during graceful shutdown.
COLLECTOR_SHUTDOWN_TIMEOUT_SECONDS=15
APP_HOST=0.0.0.0
APP_PORT=8000
# Time zone used for calendar-based report ranges such as Yesterday and Last month.
APP_TIMEZONE=UTC
WEB_HOST_PORT=8000
# Number of Uvicorn worker processes serving the web application.
WEB_WORKERS=2
ADMIN_PASSWORD=change-this-admin-password
COOKIE_SECURE=false
# Seven days of inactivity for user sessions.
SESSION_HOURS=168
# Per-web-process PostgreSQL connection pool. Keep the maximum below the server's connection limit.
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=20

# Optional Matomo Analytics
MATOMO_ENABLED=false
MATOMO_URL=https://your-matomo-instance.example
MATOMO_SITE_ID=1

# Email verification / Mailcow SMTP
APP_PUBLIC_URL=https://bminfo.ea7klk.es
# Separate admin-only pgAdmin service. It reuses SMTP_USERNAME and ADMIN_PASSWORD.
PGADMIN_HOST=bminfo-admin.example.com
SMTP_ENABLED=true
SMTP_HOST=mail.conxtor.com
SMTP_PORT=587
SMTP_USERNAME=bm-lh@ea7klk.es
SMTP_PASSWORD=change-this-mailbox-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=bm-lh@ea7klk.es
SMTP_FROM_NAME=BrandMeister Lastheard
SMTP_REPLY_TO=bm-lh@ea7klk.es
SMTP_TIMEOUT_SECONDS=20
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_HOURS=1

# Dockge/Traefik deployment
TRAEFIK_HOST=bminfo.ea7klk.es
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=acmeresolver
TRAEFIK_ROUTER_NAME=bm
TRAEFIK_SERVICE_NAME=bm
