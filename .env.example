# PostgreSQL
POSTGRES_DB=bminfo
POSTGRES_USER=bminfo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST_PORT=5432
POSTGRES_SHM_SIZE=256MB
POSTGRES_MAX_CONNECTIONS=120
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_WAL_SIZE=2GB

# Application
APP_SECRET_KEY=dev-only-insecure-signing-key-change-me-0123456789abcdef
APP_DEBUG=false
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_LANGUAGE_CODE=en-us
DB_CONN_MAX_AGE=60
APP_WORKERS=3
APP_TIMEOUT_SECONDS=120
APP_GRACEFUL_TIMEOUT_SECONDS=30
APP_KEEPALIVE_SECONDS=5
ADMIN_CALLSIGN=ADMIN
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
WEB_HOST_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false

# BrandMeister collector
BM_URL=https://api.brandmeister.network
BM_SOCKETIO_PATH=/lh/socket.io
BM_JOIN=everything
TALKGROUPS_URL=https://api.brandmeister.network/v2/talkgroup
TALKGROUPS_SYNC_HOURS=24
EXCLUDE_LOCAL_TALKGROUP=9
KERCHUNK_THRESHOLD_SECONDS=3
RAW_EVENT_KERCHUNK_THRESHOLD_SECONDS=3
COLLECTOR_HEARTBEAT_SECONDS=30

# Email verification and password reset
SMTP_ENABLED=true
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=bm-lh@example.com
SMTP_PASSWORD=change-this-mailbox-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=bm-lh@example.com
SMTP_FROM_NAME=BrandMeister Statistics by EA7KLK
SMTP_REPLY_TO=bm-lh@example.com
SMTP_TIMEOUT_SECONDS=20
EMAIL_VERIFICATION_HOURS=48
UNVERIFIED_USER_RETENTION_DAYS=5
PASSWORD_RESET_HOURS=1
# Per-transaction work_mem for the dashboard aggregate (empty inherits the server)
DASHBOARD_WORK_MEM=64MB
# Object storage for raw-event archives (Silo, S3-compatible).
# Archiving stays idle until all four of endpoint, bucket and both keys are set.
S3_ENDPOINT_URL=https://silo-api.spainip.es
S3_BUCKET=bminfo-raw
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
RAW_ARCHIVE_PREFIX=raw-events
RAW_ARCHIVE_ENABLED=true
# Reclaim disk after a pass that evicted days (VACUUM FULL, one per pass)
RAW_ARCHIVE_COMPACT=true
RAW_COMPACT_MIN_ROWS=20000
# Never rewrite a table smaller than this (bytes); 16 MiB by default
RAW_COMPACT_MIN_BYTES=16777216
RAW_COMPACT_LOCK_TIMEOUT_SECONDS=30

# Optional Matomo analytics
MATOMO_ENABLED=false
MATOMO_URL=https://analytics.example.com
MATOMO_SITE_ID=1

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-this-pgadmin-password
PGADMIN_HOST=bminfo-admin.example.com

# Dockge/Traefik deployment
GHCR_IMAGE_OWNER=ea7klk
TRAEFIK_HOST=bminfo.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=acmeresolver
TRAEFIK_ROUTER_NAME=bm
TRAEFIK_SERVICE_NAME=bm
