# PostgreSQL credentials and host-side port mapping
POSTGRES_DB=bminfo
POSTGRES_USER=bminfo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

BM_URL=https://api.brandmeister.network
BM_SOCKETIO_PATH=/lh/socket.io
BM_JOIN=everything
TALKGROUPS_URL=https://api.brandmeister.network/v2/talkgroup
TALKGROUPS_SYNC_HOURS=24
EXCLUDE_LOCAL_TALKGROUP=9
KERCHUNK_THRESHOLD_SECONDS=3
COLLECTOR_HEARTBEAT_SECONDS=30
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_HOST_PORT=8000
ADMIN_PASSWORD=change-this-admin-password
COOKIE_SECURE=false
# Seven days of inactivity for user sessions.
SESSION_HOURS=168

# Optional Matomo Analytics
MATOMO_ENABLED=false
MATOMO_URL=https://your-matomo-instance.example
MATOMO_SITE_ID=1

# Email verification / Mailcow SMTP
APP_PUBLIC_URL=https://bm.ea7klk.es
SMTP_ENABLED=true
SMTP_HOST=mail.conxtor.com
SMTP_PORT=587
SMTP_USERNAME=bm-lh@ea7klk.es
SMTP_PASSWORD=change-this-mailbox-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=bm-lh@ea7klk.es
SMTP_FROM_NAME=BrandMeister Lastheard
SMTP_REPLY_TO=bm-lh@ea7klk.es
SMTP_TIMEOUT_SECONDS=20
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_HOURS=1

# Dockge/Traefik deployment
TRAEFIK_NETWORK=traefik
TRAEFIK_HOST=bm.ea7klk.es
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=acmeresolver
TRAEFIK_ROUTER_NAME=bm
TRAEFIK_SERVICE_NAME=bm
